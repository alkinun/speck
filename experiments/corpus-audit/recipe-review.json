      "metadata_url": "https://huggingface.co/api/datasets/HuggingFaceTB/smoltalk",
      "status": "public_metadata_and_card_review_only",
      "training_admitted": false,
      "review_boundary": "Synthetic SFT mixture with multiple configurations; use requires component-level lineage, overlap and correctness review.",
      "review_findings": [
        "The card describes roughly 1M synthetic SFT samples assembled from multiple configurations and public components.",
        "New SmolTalk components are Apache-2.0 while included public datasets retain their own licenses; the aggregate card is not one uniform source-use decision.",
        "The card reports 1.7B-scale ablations and a smaller-model subset, but those results do not establish transfer to Speck's model or protocol."
      ],
      "required_checks": [
        "Split component identities, licenses, generators and revisions before any selection.",
        "Deduplicate against retained SFT stock and final evaluation families.",
        "Measure complete conversations, assistant masks, supervised tokens, correctness and tool/schema validity by component."
      ]
    }
  ],
