      "revision": "469216e3f46f4dacf476b382e192485ea51a143e",
      "last_modified": "2024-11-25T20:07:28.000Z",
      "gated": false,
      "card_url": "https://huggingface.co/datasets/nvidia/OpenMathInstruct-2/resolve/469216e3f46f4dacf476b382e192485ea51a143e/README.md",
      "card_sha256": "8d0513c2f85e6ee1258f109017c2565f638cc10a72f1ffbee34ab8601c0dc199",
      "metadata_sha256": "a98a62bdcdfcec238fd0bbdf6cef438801759d06f00405fd1d0dd8470b56198e",
      "metadata_url": "https://huggingface.co/api/datasets/nvidia/OpenMathInstruct-2",
      "status": "public_metadata_and_card_review_only",
      "training_admitted": false,
      "review_boundary": "14M synthetic math problem-solution pairs; contamination explorer and source/test lineage require review before any use.",
      "review_findings": [
        "Solutions are generated with Llama3.1-405B-Instruct from GSM8K/MATH originals and augmented problems.",
        "The card exposes 1M, 2M and 5M downsampled splits and a contamination explorer for GSM8K, MATH, AMC 2023, AIME 2024 and Omni-MATH.",
        "The card recommends removing extremely long questions; answer agreement is not independent correctness certification."
      ],
      "required_checks": [
        "Pin a declared split and count problem-source strata.",
        "Join every evaluation family and freeze contamination exclusions before selection.",
        "Verify expected answers with an independent arithmetic/symbolic oracle and retain unresolved cases."
      ]
    },
    {
      "repository": "HuggingFaceTB/finemath",
      "revision": "e92b25a616738fe95dc186b64dfb19f9c8525594",
      "last_modified": "2025-02-06T10:31:11.000Z",
      "gated": false,
      "card_url": "https://huggingface.co/datasets/HuggingFaceTB/finemath/resolve/e92b25a616738fe95dc186b64dfb19f9c8525594/README.md",
      "card_sha256": "77b9162c99fc6b5944da8793f18fb99c3b520ab7cdce0cc67ec8a1e47871da61",
      "metadata_sha256": "4f687cec8c84c19b28bbbba61c70fb0c6aadc5f1e26129a958492ffd2570019e",
      "metadata_url": "https://huggingface.co/api/datasets/HuggingFaceTB/finemath",
      "status": "public_metadata_and_card_review_only",
      "training_admitted": false,
      "review_boundary": "FineMath and InfiMM-WebMath configurations are metadata candidates; retained FineMath 4+ evidence remains a separate stock identity.",
      "review_findings": [
        "The card describes FineMath-3+ and FineMath-4+ plus separate InfiMM-WebMath-3+ and -4+ configurations.",
        "The published pipeline uses classifier filtering, deduplication and 13-gram benchmark decontamination; the card reports that deduplicating pages repeated between FineMath and InfiWebMath changes measured performance.",
        "The retained FineMath 4+ inventory was acquired and audited separately; these card configurations do not rewrite that identity."
      ],
      "required_checks": [
        "Keep each configuration and release revision as a separate source family.",
        "Reconcile benchmark decontamination with Speck's held-out graph and measure cross-configuration overlap.",
        "Check mathematical extraction, completeness and correctness independently before assigning a refined share."
      ]
    },
