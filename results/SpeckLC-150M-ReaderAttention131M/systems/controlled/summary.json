{
  "comparison": "thermally controlled eager and compiled five-cache versus caches-3 inference",
  "environment": {
    "cuda": "12.8",
    "device": "NVIDIA GeForce RTX 3090",
    "flash_linear_attention": "0.5.0",
    "torch": "2.9.1+cu128"
  },
  "findings": [
    "eager high-batch decode reproduces a 1.31x caches-3 speedup at both 32K batch 16 and 128K batch 4",
    "compiled high-batch decode retains a 1.28x speedup at 32K and 1.27x at 128K",
    "prefill differs by less than 0.5 percent between eager arms and 1.2 percent between compiled arms",
    "compile improves prefill by 1.04x to 1.38x, with the largest gains at batch one",
    "compile does not improve reader decode: high-batch latency is flat and batch-one latency regresses by 61 to 64 percent",
    "compiled caches-3 batch-one decode is 29 percent slower than five caches at 32K and 34 percent slower at 128K",
    "caches-3 does not reduce measured peak allocation at 524288 cached slots; it is about 0.375 GiB higher despite the smaller analytic resident state",
    "compile startup was excluded by warmups but not separately timed, so these are steady-state measurements only"
  ],
