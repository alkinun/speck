  "official_report_semantics": {
    "Full_AttnRes": {
      "weight_equation": 2,
      "query_key_value_equation": 3,
      "input_equation": 4,
      "sources": "embedding plus every completed attention or MLP residual-module output",
      "query": "one learned hidden-size pseudo-query per receiving residual module",
      "keys": "each source independently RMS-normalized",
      "scores": "unscaled pseudo-query dot normalized key",
      "weights": "one source-axis softmax head",
      "values": "unnormalized source values",
      "pseudo_query_initialization": "exact zero",
      "initial_weights": "uniform over available sources"
    },
    "Block_AttnRes": {
      "block_sum_equation": 5,
      "source_set_equation": 6,
      "source_zero": "token embedding",
      "completed_source": "sum of every attention and MLP update in a completed block",
      "current_source": "partial sum within the current block after its first residual module",
      "first_module_source_set": "embedding plus completed blocks only",
      "later_module_source_set": "embedding plus completed blocks plus current partial sum",
      "final_output": "attention over all completed blocks and any final partial block",
      "block_size_unit": "attention and MLP residual sublayers",
      "boundary_constraint": "new blocks begin only at Transformer logical-layer boundaries",
      "two_phase_exact_online_softmax_required_for_optimized_path": true
    }
  },
