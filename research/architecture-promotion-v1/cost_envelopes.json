      "hard_envelope": {
        "minimum_resident_batch": 16,
        "p99_decode_step_ms": 20,
        "maximum_prefill_seconds_for_batch": 8
      },
      "primary_cost_metric": "output_tokens_per_gpu_second_at_latency_envelope"
    },
    {
      "id": "long_context_128k",
      "hardware": "research_rtx3090",
      "prompt_length": 131072,
      "output_tokens": 128,
      "hard_envelope": {
        "p99_ttft_seconds_batch_1": 4,
        "p99_tpot_ms_batch_1": 20,
        "minimum_resident_batch_at_524288_cached_slots": 4,
        "maximum_resident_state_mib_batch_1": 512,
        "maximum_peak_allocated_gib_batch_1": 4
