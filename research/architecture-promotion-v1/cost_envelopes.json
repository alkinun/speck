  "cost_accounting": {
    "training_usd": "gpu_hours * (hourly_hardware_amortization_usd_excluding_energy + average_power_kw * electricity_usd_per_kwh)",
    "serving_usd_per_million_output_tokens": "1000000 * (hourly_hardware_amortization_usd_excluding_energy + average_power_kw * electricity_usd_per_kwh) / output_tokens_per_hour",
    "required_physical_metrics": [
      "gpu_seconds",
      "average_power_watts_when_available",
      "peak_allocated_bytes",
      "resident_model_bytes",
      "resident_sequence_state_bytes",
      "input_tokens",
      "output_tokens"
    ],
    "relative_decision_rule": "when monetary inputs are unavailable, use physical time, power, and memory separately; never report a fabricated dollar cost"
  },
  "architecture_freeze_blocker": "a named datacenter deployment profile on the intended production runtime must be added in a new version before architecture freeze"
}
