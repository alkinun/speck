      ],
      "output_tokens": 128,
      "hard_envelope": {
        "p99_ttft_ms_at_4k": 250,
        "p99_tpot_ms": 20,
        "maximum_weights_plus_state_gib": 20
      },
      "primary_cost_metric": "p99_tpot_ms"
    },
    {
      "id": "throughput_32k",
      "hardware": "research_rtx3090",
      "prompt_length": 32768,
