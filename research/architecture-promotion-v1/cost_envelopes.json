  "policy_id": "architecture-promotion-v1",
  "status": "active_research_hardware",
  "frozen_on": "2026-09-05",
  "hardware": {
    "research_rtx3090": {
      "gpu": "NVIDIA GeForce RTX 3090",
      "gpu_memory_gib": 24,
      "driver": "610.43.03",
      "torch": "2.9.1+cu128",
      "cuda_runtime": "12.8",
      "triton": "3.5.1",
      "flash_linear_attention": "0.5.0",
      "ownership": "local",
      "hourly_hardware_amortization_usd_excluding_energy": null,
      "electricity_usd_per_kwh": null,
      "note": "Monetary cost is reported only when both accounting inputs are supplied in a result artifact."
