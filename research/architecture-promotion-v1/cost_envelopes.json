  },
  "measurement_controls": {
    "tokenization_in_timing": false,
    "include_argmax_or_sampler": true,
    "synchronize_cuda": true,
    "report_percentiles": [
      50,
      90,
      99
    ],
    "minimum_thermally_interleaved_blocks": 5,
    "minimum_microbenchmark_iterations_per_block": 30,
    "minimum_online_requests_for_p99": 1000,
    "interleave_candidate_and_control": true,
    "maximum_start_temperature_c": 50,
    "report_compile_startup_separately": true,
    "report_eager_and_compiled": true,
    "record_software_and_model_hashes": true
  },
  "training_profiles": [
    {
      "id": "proxy_150m_4k",
      "hardware": "research_rtx3090",
      "parameter_range": [
        130000000,
        170000000
      ],
      "sequence_length": 4096,
      "optimizer_batch_tokens": 65536,
      "discovery_tokens": 131072000,
      "hard_envelope": {
        "maximum_peak_allocated_gib": 16,
        "minimum_steady_tokens_per_second": 40000,
        "maximum_gpu_hours_per_discovery_run": 1.0,
        "non_finite_steps": 0
      },
      "primary_cost_metric": "gpu_seconds_to_locked_validation_loss",
      "quality_target_rule": "lock a reachable validation-loss threshold from control-only pilots before candidate results are evaluated",
      "promotion_target": "at least 10% lower time-to-quality for a simple component or 20% for a component requiring a custom runtime"
    },
    {
      "id": "medium_scale_transfer",
      "hardware": "to_be_named_before_launch",
      "parameter_range": [
        300000000,
        600000000
      ],
      "sequence_length": 4096,
      "hard_envelope": null,
      "primary_cost_metric": "gpu_seconds_to_locked_validation_and_capability_targets",
      "launch_gate": "hardware, parallelism, batch geometry, monetary inputs, and absolute envelopes must be frozen in policy v2 before training"
    }
  ],
  "serving_profiles": [
    {
      "id": "local_interactive_4k",
      "hardware": "research_rtx3090",
      "batch_size": 1,
      "prompt_lengths": [
