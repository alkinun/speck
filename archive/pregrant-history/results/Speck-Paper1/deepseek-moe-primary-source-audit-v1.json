  "primary_report_semantics": {
    "generic_MoE": {
      "equations": [
        3,
        4,
        5
      ],
      "router": "full softmax over expert affinities",
      "selection": "top-k experts",
      "mixture_weights": "selected entries retain their original full-softmax probabilities without selected-only renormalization",
      "expert_output": "sum of selected weighted FFNs plus residual"
    },
    "fine_grained_segmentation": {
      "equations": [
        6,
        7,
        8
      ],
      "operation": "split each expert intermediate width by factor m and multiply total and active expert counts by m",
      "matching_claim": "expert parameter count and active expert arithmetic held constant in the conceptual comparison"
    },
    "shared_expert_isolation": {
      "equations": [
        9,
        10,
        11
      ],
      "operation": "always add K_s shared expert outputs and route only among the remaining experts",
      "fixed_compute_adjustment": "reduce active routed count by K_s when comparing at fixed total active experts"
    },
    "DeepSeekMoE_16B": {
      "hidden_size": 2048,
